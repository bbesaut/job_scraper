# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=

# DEV or PROD — restricts which channel the bot listens/responds in
ENVIRONNEMENT=DEV

# Discord channel ID used for the DEV environment
TEST_CHANNEL_ID=

# true = scrape and log what would be sent, but post no job on Discord.
# Leave empty for the default: on in DEV, off in PROD. Set to false to really send in DEV.
DRY_RUN=
